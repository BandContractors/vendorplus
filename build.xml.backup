        <copy file="${file.reference.mysql-connector-java-5.1.7-bin.jar}" todir="${build.web.dir}/WEB-INF/lib"/>
        <copy file="${file.reference.poi-3.10-FINAL-20140208.jar}" todir="${build.web.dir}/WEB-INF/lib"/>
        <copy file="${file.reference.poi-examples-3.10-FINAL-20140208.jar}" todir="${build.web.dir}/WEB-INF/lib"/>
        <copy file="${file.reference.poi-excelant-3.10-FINAL-20140208.jar}" todir="${build.web.dir}/WEB-INF/lib"/>
        <copy file="${file.reference.poi-ooxml-3.10-FINAL-20140208.jar}" todir="${build.web.dir}/WEB-INF/lib"/>
        <copy file="${file.reference.poi-ooxml-schemas-3.10-FINAL-20140208.jar}" todir="${build.web.dir}/WEB-INF/lib"/>
        <copy file="${file.reference.poi-scratchpad-3.10-FINAL-20140208.jar}" todir="${build.web.dir}/WEB-INF/lib"/>
