        <copy file="${file.reference.com.sun.mail_1.4.2.jar}" todir="${build.web.dir}/WEB-INF/lib"/>
        <copy file="${file.reference.javax.mail-1.5.0.jar}" todir="${build.web.dir}/WEB-INF/lib"/>
        <copy file="${file.reference.primefaces-7.0.jar}" todir="${build.web.dir}/WEB-INF/lib"/>
